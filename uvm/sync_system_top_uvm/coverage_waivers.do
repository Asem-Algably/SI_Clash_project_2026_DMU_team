coverage exclude -scope /top/dut/u_str/u_lock_detector -fecexprrow 68 3 -comment {Init_Error > thr until idx_ok_r sets on symbol 0}

# Top-level STR lock hysteresis decrement covered in standalone str_uvm (physical top SNR/amplitude stays within thr_exit)
coverage exclude -scope /top/dut/u_str/u_lock_detector -linerange 73-74 -code bcs -comment {Covered 100% in standalone str_uvm}

